# Copy to ".env.local" (gitignored) and restart `npm run dev`.

# SQLite database (created beside prisma/schema after `npm run db:push`)
DATABASE_URL="file:./dev.db"

# NextAuth — required for sign-in (empty value breaks auth with error=Configuration).
# Generate your own: `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-or-use-this-local-placeholder-only
# Must match the origin you open in the browser (including port). Use http://localhost:3007 when running `npm run dev:3007`.
NEXTAUTH_URL=http://localhost:3007

# OpenAI — Learn assistant on /courses and /learning-paths
OPENAI_API_KEY=
